<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="DongWang.IronVault"
    Publisher="CN=68653AD0-385D-4B73-A7F9-5D186EB5B86A"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>IronVault</DisplayName>
    <PublisherDisplayName>Dong Wang</PublisherDisplayName>
    <!-- StoreLogo: 50×50 px, generated by CI; replace with your artwork -->
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Retro tank-battle game — 100 hand-crafted stages, CRT aesthetic, bilingual.</Description>
  </Properties>

  <!-- Requires Windows 10 version 1809 (October 2018 Update) or later -->
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="IronVault.Desktop.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Iron Vault"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Retro tank-battle game — 100 hand-crafted stages."
        BackgroundColor="#0a0800">

        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Iron Vault">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo"   />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>

        <uap:SplashScreen
          Image="Assets\SplashScreen.png"
          BackgroundColor="#0a0800" />

      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full-trust is required for .NET NativeAOT desktop apps -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
