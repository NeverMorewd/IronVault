<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pipboy="clr-namespace:Pipboy.Avalonia;assembly=Pipboy.Avalonia"
             x:Class="IronVault.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <pipboy:PipboyTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, fonts:IronVault#Noto Sans SC" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="Inter, fonts:IronVault#Noto Sans SC" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Inter, fonts:IronVault#Noto Sans SC" />
        </Style>

        <!-- Deploy button: dark green background, bright green border/text (less blinding than accent) -->
        <Style Selector="Button.deploy">
            <Setter Property="Background"       Value="#0D3D00" />
            <Setter Property="Foreground"       Value="#39FF14" />
            <Setter Property="BorderBrush"      Value="#39FF14" />
            <Setter Property="BorderThickness"  Value="1" />
        </Style>
        <Style Selector="Button.deploy:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#163D00" />
        </Style>
        <Style Selector="Button.deploy:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0A2800" />
        </Style>
    </Application.Styles>
</Application>
