<UserControl
    x:Class="IronVault.Views.MenuView"
    xmlns="https://github.com/avaloniaui"
    xmlns:pipboy="clr-namespace:Pipboy.Avalonia;assembly=Pipboy.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource PipboyBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                HorizontalAlignment="Stretch"
                Margin="16,14,16,14"
                Spacing="10"
                VerticalAlignment="Center">

                <!--  ══ HEADER ══════════════════════════════════════════════════════════  -->
                <Border Classes="pipboy-panel">
                    <StackPanel Spacing="6">

                        <!--  Title row with bracket decorations  -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock
                                FontSize="26"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Opacity="0.55"
                                Text="▌"
                                VerticalAlignment="Center" />
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    Classes="h1"
                                    FontSize="30"
                                    HorizontalAlignment="Center"
                                    LetterSpacing="4"
                                    Text="IRON VAULT"
                                    x:Name="TitleText" />
                                <TextBlock
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Opacity="0.65"
                                    Text="铁  窖  计  划"
                                    x:Name="SubtitleText" />
                            </StackPanel>
                            <TextBlock
                                FontSize="26"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Opacity="0.55"
                                Text="▌"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Separator />

                        <TextBlock
                            Classes="dim"
                            FontSize="10"
                            HorizontalAlignment="Center"
                            LetterSpacing="1"
                            x:Name="TaglineText" />

                    </StackPanel>
                </Border>

                <!--  ══ MODE  +  DIFFICULTY (side by side) ══════════════════════════════  -->
                <Grid ColumnDefinitions="*,12,*">

                    <!--  LEFT: Operation Mode  -->
                    <Border Classes="pipboy-panel" Grid.Column="0">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="h2"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                x:Name="ModeLabel" />
                            <StackPanel Spacing="5">
                                <Button
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    x:Name="ClassicBtn" />
                                <Button
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    x:Name="DefenseBtn" />
                            </StackPanel>
                            <TextBlock
                                Classes="dim"
                                FontSize="10"
                                Height="32"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                x:Name="ModeDesc" />
                        </StackPanel>
                    </Border>

                    <!--  RIGHT: Tactical Rating  -->
                    <Border Classes="pipboy-panel" Grid.Column="2">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="h2"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                x:Name="DifficultyLabel" />
                            <StackPanel Spacing="5">
                                <Button
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    x:Name="EasyBtn" />
                                <Button
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    x:Name="NormalBtn" />
                                <Button
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    x:Name="HardBtn" />
                            </StackPanel>
                            <TextBlock
                                Classes="dim"
                                FontSize="10"
                                Height="32"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                x:Name="DiffDesc" />
                        </StackPanel>
                    </Border>

                </Grid>

                <!--  ══ SYSTEM STATUS STRIP ══════════════════════════════════════════════  -->
                <Border Classes="pipboy-panel" Padding="12,7">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="● VECTOR ENGINE    ONLINE" />
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="● AUDIO SYNTH      READY" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="3">
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="TACTICAL AI    STANDBY ●" />
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="MAP LIBRARY   100 LVL  ●" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ══ DEPLOY BUTTON ════════════════════════════════════════════════════  -->
                <Button
                    Classes="deploy"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,14"
                    x:Name="StartBtn">
                    <TextBlock
                        FontWeight="Bold"
                        LetterSpacing="2"
                        x:Name="DeployText" />
                </Button>

                <!--  ══ ABORT  +  LANGUAGE ═══════════════════════════════════════════════  -->
                <Grid ColumnDefinitions="*,Auto">

                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,8,0"
                        Padding="10,8"
                        x:Name="ExitBtn">
                        <TextBlock Classes="dim" x:Name="AbortText" />
                    </Button>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock
                            Classes="dim"
                            FontSize="11"
                            VerticalAlignment="Center"
                            x:Name="LangLabel" />
                        <Button
                            HorizontalContentAlignment="Center"
                            Width="80"
                            x:Name="LangEnBtn" />
                        <Button
                            HorizontalContentAlignment="Center"
                            Width="80"
                            x:Name="LangZhBtn" />
                    </StackPanel>

                </Grid>

                <!--  ══ FOOTER ═══════════════════════════════════════════════════════════  -->
                <TextBlock
                    Classes="dim"
                    FontSize="8"
                    HorizontalAlignment="Center"
                    Opacity="0.55"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    x:Name="FooterText" />

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
