<UserControl
    x:Class="IronVault.Views.MenuView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pipboy="clr-namespace:Pipboy.Avalonia;assembly=Pipboy.Avalonia">

    <Grid Background="{DynamicResource PipboyBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="16,14,16,14"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="10">

                <!--  ══ HEADER ══════════════════════════════════════════════════════════  -->
                <Border Classes="pipboy-panel">
                    <StackPanel Spacing="6">

                        <!--  Title row with bracket decorations  -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="26"
                                Opacity="0.55"
                                Text="▌" />
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    x:Name="TitleText"
                                    HorizontalAlignment="Center"
                                    Classes="h1"
                                    FontSize="30"
                                    LetterSpacing="4"
                                    Text="IRON VAULT" />
                                <TextBlock
                                    x:Name="SubtitleText"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Opacity="0.65"
                                    Text="铁  窖  计  划" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="26"
                                Opacity="0.55"
                                Text="▌" />
                        </Grid>

                        <Separator />

                        <TextBlock
                            x:Name="TaglineText"
                            HorizontalAlignment="Center"
                            Classes="dim"
                            FontSize="10"
                            LetterSpacing="1" />

                    </StackPanel>
                </Border>

                <!--  ══ MODE  +  DIFFICULTY (side by side) ══════════════════════════════  -->
                <Grid ColumnDefinitions="*,12,*">

                    <!--  LEFT: Operation Mode  -->
                    <Border Grid.Column="0" Classes="pipboy-panel">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="ModeLabel"
                                HorizontalAlignment="Center"
                                Classes="h2"
                                FontSize="11" />
                            <StackPanel Spacing="5">
                                <Button
                                    x:Name="ClassicBtn"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontSize="12" />
                                <Button
                                    x:Name="DefenseBtn"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontSize="12" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ModeDesc"
                                Height="32"
                                Classes="dim"
                                FontSize="10"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  RIGHT: Tactical Rating  -->
                    <Border Grid.Column="2" Classes="pipboy-panel">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="DifficultyLabel"
                                HorizontalAlignment="Center"
                                Classes="h2"
                                FontSize="11" />
                            <StackPanel Spacing="5">
                                <Button
                                    x:Name="EasyBtn"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontSize="12" />
                                <Button
                                    x:Name="NormalBtn"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontSize="12" />
                                <Button
                                    x:Name="HardBtn"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontSize="12" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DiffDesc"
                                Height="32"
                                Classes="dim"
                                FontSize="10"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </Grid>

                <!--  ══ SYSTEM STATUS STRIP ══════════════════════════════════════════════  -->
                <Border Padding="12,7" Classes="pipboy-panel">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="● VECTOR ENGINE    ONLINE" />
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="● AUDIO SYNTH      READY" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="3">
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="TACTICAL AI    STANDBY ●" />
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="MAP LIBRARY   100 LVL  ●" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ══ DEPLOY BUTTON ════════════════════════════════════════════════════  -->
                <Button
                    x:Name="StartBtn"
                    Padding="12,14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Classes="deploy"
                    FontSize="16">
                    <TextBlock
                        x:Name="DeployText"
                        FontWeight="Bold"
                        LetterSpacing="2" />
                </Button>

                <!--  ══ ABORT  +  LANGUAGE ═══════════════════════════════════════════════  -->
                <Grid ColumnDefinitions="*,Auto">

                    <Button
                        x:Name="ExitBtn"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                        <TextBlock x:Name="AbortText" Classes="dim" />
                    </Button>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            x:Name="LangLabel"
                            VerticalAlignment="Center"
                            Classes="dim"
                            FontSize="11" />
                        <Button
                            x:Name="LangEnBtn"
                            Width="80"
                            HorizontalContentAlignment="Center" />
                        <Button
                            x:Name="LangZhBtn"
                            Width="80"
                            HorizontalContentAlignment="Center" />
                    </StackPanel>

                </Grid>

                <SelectableTextBlock
					Margin="0,3,0,0"
                    x:Name="FooterText"
                    HorizontalAlignment="Center"
                    Classes="dim"
                    FontSize="9"
                    Opacity="0.55"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
