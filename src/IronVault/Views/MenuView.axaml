<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pipboy="clr-namespace:Pipboy.Avalonia;assembly=Pipboy.Avalonia"
             x:Class="IronVault.Views.MenuView">

  <Grid Background="{DynamicResource PipboyBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
  <StackPanel VerticalAlignment="Center"
              HorizontalAlignment="Stretch"
              Margin="16,14,16,14"
              Spacing="10">

    <!-- ══ HEADER ══════════════════════════════════════════════════════════ -->
    <Border Classes="pipboy-panel">
      <StackPanel Spacing="6">

        <!-- Title row with bracket decorations -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0"
                     Text="▌"
                     FontSize="26"
                     Opacity="0.55"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="3">
            <TextBlock x:Name="TitleText"
                       Text="IRON VAULT"
                       Classes="h1"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       LetterSpacing="4" />
            <TextBlock x:Name="SubtitleText"
                       Text="铁  窖  计  划"
                       HorizontalAlignment="Center"
                       Opacity="0.65"
                       FontSize="14" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     Text="▌"
                     FontSize="26"
                     Opacity="0.55"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0" />
        </Grid>

        <Separator />

        <TextBlock x:Name="TaglineText"
                   Classes="dim"
                   HorizontalAlignment="Center"
                   FontSize="10"
                   LetterSpacing="1" />

      </StackPanel>
    </Border>

    <!-- ══ MODE  +  DIFFICULTY (side by side) ══════════════════════════════ -->
    <Grid ColumnDefinitions="*,12,*">

      <!-- LEFT: Operation Mode -->
      <Border Classes="pipboy-panel" Grid.Column="0">
        <StackPanel Spacing="8">
          <TextBlock x:Name="ModeLabel"
                     Classes="h2"
                     HorizontalAlignment="Center"
                     FontSize="11" />
          <StackPanel Spacing="5">
            <Button x:Name="ClassicBtn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12" />
            <Button x:Name="DefenseBtn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12" />
          </StackPanel>
          <TextBlock x:Name="ModeDesc"
                     Classes="dim"
                     FontSize="10"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Height="32" />
        </StackPanel>
      </Border>

      <!-- RIGHT: Tactical Rating -->
      <Border Classes="pipboy-panel" Grid.Column="2">
        <StackPanel Spacing="8">
          <TextBlock x:Name="DifficultyLabel"
                     Classes="h2"
                     HorizontalAlignment="Center"
                     FontSize="11" />
          <StackPanel Spacing="5">
            <Button x:Name="EasyBtn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12" />
            <Button x:Name="NormalBtn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12" />
            <Button x:Name="HardBtn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12" />
          </StackPanel>
          <TextBlock x:Name="DiffDesc"
                     Classes="dim"
                     FontSize="10"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Height="32" />
        </StackPanel>
      </Border>

    </Grid>

    <!-- ══ SYSTEM STATUS STRIP ══════════════════════════════════════════════ -->
    <Border Classes="pipboy-panel" Padding="12,7">
      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="● VECTOR ENGINE    ONLINE" Classes="dim" FontSize="9" />
          <TextBlock Text="● AUDIO SYNTH      READY"  Classes="dim" FontSize="9" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
          <TextBlock Text="TACTICAL AI    STANDBY ●" Classes="dim" FontSize="9" />
          <TextBlock Text="MAP LIBRARY   100 LVL  ●" Classes="dim" FontSize="9" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ DEPLOY BUTTON ════════════════════════════════════════════════════ -->
    <Button x:Name="StartBtn"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            FontSize="16"
            Padding="12,14"
            Classes="deploy">
      <TextBlock x:Name="DeployText"
                 FontWeight="Bold"
                 LetterSpacing="2" />
    </Button>

    <!-- ══ ABORT  +  LANGUAGE ═══════════════════════════════════════════════ -->
    <Grid ColumnDefinitions="*,Auto">

      <Button x:Name="ExitBtn"
              Grid.Column="0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="10,8"
              Margin="0,0,8,0">
        <TextBlock x:Name="AbortText" Classes="dim" />
      </Button>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
        <TextBlock x:Name="LangLabel"
                   Classes="dim"
                   FontSize="11"
                   VerticalAlignment="Center" />
        <Button x:Name="LangEnBtn"
                Width="80"
                HorizontalContentAlignment="Center" />
        <Button x:Name="LangZhBtn"
                Width="80"
                HorizontalContentAlignment="Center" />
      </StackPanel>

    </Grid>

    <!-- ══ FOOTER ═══════════════════════════════════════════════════════════ -->
    <TextBlock x:Name="FooterText"
               Classes="dim"
               FontSize="8"
               HorizontalAlignment="Center"
               TextWrapping="Wrap"
               TextAlignment="Center"
               Opacity="0.55" />

  </StackPanel>
  </ScrollViewer>
  </Grid>

</UserControl>
