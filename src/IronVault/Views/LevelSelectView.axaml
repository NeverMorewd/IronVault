<UserControl
    x:Class="IronVault.Views.LevelSelectView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource PipboyBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                HorizontalAlignment="Center"
                Margin="14,12,14,12"
                MaxWidth="720"
                Spacing="10"
                VerticalAlignment="Center">

                <!--  ══ HEADER ═══════════════════════════════════════════════════════════  -->
                <Border Classes="pipboy-panel">
                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                Classes="h1"
                                FontSize="18"
                                LetterSpacing="2"
                                x:Name="SelectLabel" />
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                Text="▌ 10 OPERATIONAL ZONES  ·  100 COMBAT SECTORS" />
                            <TextBlock
                                Classes="dim"
                                FontSize="9"
                                TextWrapping="Wrap"
                                x:Name="HintText" />
                        </StackPanel>

                        <!--  Back button anchored top-right  -->
                        <Button
                            Classes="ghost"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="16,10"
                            VerticalAlignment="Center"
                            x:Name="BackBtn">
                            <TextBlock
                                Classes="dim"
                                FontSize="11"
                                x:Name="BackText" />
                        </Button>

                    </Grid>
                </Border>

                <!--  ══ TACTICAL MAP GRID ═════════════════════════════════════════════════  -->
                <!--  Wrapped in a horizontal ScrollViewer so it stays usable on narrow screens  -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Border Classes="pipboy-panel" Padding="10">
                        <!--
                            Grid is built entirely in code-behind (BuildGrid).
                            Row 0 = column-number labels (1-10).
                            Col 0 = zone-letter labels (A-J).
                            Rows 1-10 × Cols 1-10 = level buttons.
                        -->
                        <Grid HorizontalAlignment="Left" x:Name="LevelGrid" />
                    </Border>
                </ScrollViewer>

                <!--  ══ MISSION BRIEFING / DEPLOY ════════════════════════════════════════  -->
                <Border Classes="pipboy-panel" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!--  Grid coordinate badge  -->
                        <Border
                            BorderBrush="{DynamicResource PipboyBorderBrush}"
                            BorderThickness="1"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="10,6"
                            VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Classes="dim"
                                    FontSize="8"
                                    HorizontalAlignment="Center"
                                    Text="GRID" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    x:Name="CoordText" />
                            </StackPanel>
                        </Border>

                        <!--  Stage name + theme  -->
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                x:Name="StageNameText" />
                            <TextBlock
                                Classes="dim"
                                FontSize="11"
                                x:Name="ThemeNameText" />
                        </StackPanel>

                        <!--  Deploy button  -->
                        <Button
                            Classes="deploy"
                            FontSize="14"
                            Grid.Column="2"
                            Padding="24,12"
                            VerticalAlignment="Center"
                            x:Name="DeployBtn" />

                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
