<UserControl
    x:Class="IronVault.Views.UpgradeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:pipboy="clr-namespace:Pipboy.Avalonia;assembly=Pipboy.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource PipboyBackgroundBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            MaxWidth="600"
            MinWidth="520"
            Spacing="0"
            VerticalAlignment="Center">

            <!--  ── Wave cleared header ──  -->
            <Border Classes="pipboy-panel" Margin="0,0,0,18">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock
                        Classes="h1"
                        FontSize="26"
                        HorizontalAlignment="Center"
                        x:Name="WaveClearedText" />
                    <TextBlock
                        Classes="dim"
                        HorizontalAlignment="Center"
                        Text="——  TACTICAL DEBRIEF  ——"
                        x:Name="DebriefLabel" />
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,6,0,0">
                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                Classes="dim"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                Text="SCORE"
                                x:Name="ScoreLabel" />
                            <TextBlock
                                FontSize="22"
                                HorizontalAlignment="Center"
                                x:Name="ScoreText" />
                        </StackPanel>
                        <Border
                            Background="{DynamicResource PipboyBorderBrush}"
                            Grid.Column="1"
                            Margin="16,0"
                            Width="1" />
                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                Classes="dim"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                Text="NEXT WAVE"
                                x:Name="NextWaveLabel" />
                            <TextBlock
                                FontSize="22"
                                HorizontalAlignment="Center"
                                x:Name="NextWaveText" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ── Upgrade section header ──  -->
            <TextBlock
                Classes="h2"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                Text="◆  SELECT FIELD UPGRADE  ◆"
                x:Name="SelectHeader" />

            <!--  ── Upgrade card 0 ──  -->
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="0,0,0,7"
                Padding="16,12"
                x:Name="UpBtn0">
                <Grid ColumnDefinitions="44,*,Auto">
                    <TextBlock
                        FontSize="22"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:Name="UpIcon0" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" x:Name="UpName0" />
                        <TextBlock
                            Classes="dim"
                            FontSize="11"
                            x:Name="UpDesc0" />
                    </StackPanel>
                    <TextBlock
                        Classes="dim"
                        FontSize="11"
                        Grid.Column="2"
                        Text="[ SELECT ]"
                        VerticalAlignment="Center"
                        x:Name="SelectHint0" />
                </Grid>
            </Button>

            <!--  ── Upgrade card 1 ──  -->
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="0,0,0,7"
                Padding="16,12"
                x:Name="UpBtn1">
                <Grid ColumnDefinitions="44,*,Auto">
                    <TextBlock
                        FontSize="22"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:Name="UpIcon1" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" x:Name="UpName1" />
                        <TextBlock
                            Classes="dim"
                            FontSize="11"
                            x:Name="UpDesc1" />
                    </StackPanel>
                    <TextBlock
                        Classes="dim"
                        FontSize="11"
                        Grid.Column="2"
                        Text="[ SELECT ]"
                        VerticalAlignment="Center"
                        x:Name="SelectHint1" />
                </Grid>
            </Button>

            <!--  ── Upgrade card 2 ──  -->
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="0,0,0,7"
                Padding="16,12"
                x:Name="UpBtn2">
                <Grid ColumnDefinitions="44,*,Auto">
                    <TextBlock
                        FontSize="22"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:Name="UpIcon2" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" x:Name="UpName2" />
                        <TextBlock
                            Classes="dim"
                            FontSize="11"
                            x:Name="UpDesc2" />
                    </StackPanel>
                    <TextBlock
                        Classes="dim"
                        FontSize="11"
                        Grid.Column="2"
                        Text="[ SELECT ]"
                        VerticalAlignment="Center"
                        x:Name="SelectHint2" />
                </Grid>
            </Button>

            <!--  ── Ally reward notice ──  -->
            <Border
                Classes="pipboy-panel"
                IsVisible="False"
                Margin="0,8,0,0"
                x:Name="AllyRewardBanner">
                <TextBlock
                    Classes="accent"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Text="◈  ALLY TANK DEPLOYED TO YOUR POSITION"
                    x:Name="AllyRewardText" />
            </Border>

            <!--  ── Skip ──  -->
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,14,0,0"
                Padding="10,8"
                x:Name="SkipBtn">
                <TextBlock
                    Classes="dim"
                    Text="▷  SKIP — DEPLOY NEXT WAVE  ◁"
                    x:Name="SkipText" />
            </Button>

        </StackPanel>
    </Grid>

</UserControl>
